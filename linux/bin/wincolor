#!/bin/bash
# wincolor - ウィンドウ単位で枠＋タイトルバーの色タグを付ける
#
# 使い方:
#   wincolor list                 ウィンドウ一覧 (ID / クラス / 現在の色 / タイトル)
#   wincolor colors               使える色プリセット一覧 (shared/colors.json 由来。名前 / ラベル / HEX)
#   wincolor <ID> <色>            指定ウィンドウに色を付ける (プリセット名 red, 青 など、または #RRGGBB)
#   wincolor <ID> off             指定ウィンドウの色を消す
#   wincolor focused <色>         フォーカス中のウィンドウに色 (キーバインド向け)
#   wincolor focused next|prev    パレットを順送り/逆送り (末尾の次は色なし)
#   wincolor focused off
#   wincolor clear-all            全部消す
#   wincolor run <色> <コマンド...>  コマンドを起動し、そのウィンドウに色を付ける (ランチャー。
#                                 .desktop の Exec= やショートカットに書く。WINCOLOR_RUN_TIMEOUT 秒、既定 10)
#   wincolor rules                読み込み済みの自動ルール一覧 (title / exe / color)
#   wincolor reload               colors.json / rules.json を再読み込み (保存時にも自動で再読み込みされる)
#   wincolor --version            バージョン表示
#
# 自動ルール: ~/.config/wincolor/rules.json (install.sh が雛形を置く) に
#   { "rules": [ { "title": "本番|prod", "color": "red" }, { "exe": "keepass", "color": "purple" } ] }
#   のように書くと、条件に合う新しいウィンドウへ自動で色が付く。title / exe は正規表現
#   (大文字小文字無視)。exe はプロセス名と WM_CLASS (app-id) のどちらかに一致すればよい。
#   手動で色を付けた・消したウィンドウには適用しない。
#
# キーバインド (拡張が mutter に登録、Wayland ネイティブ窓でも効く):
#   Super+C  フォーカス中ウィンドウのウィンドウメニューを開く (CSD 窓向け)
#   Super+X  色タグを順送り
set -eu

WINCOLOR_VERSION=0.2.3

DEST=org.gnome.Shell
PATH_=/jp/smart2j/WindowColorTag
IFACE=jp.smart2j.WindowColorTag

call() {
    local method=$1; shift
    local out
    out=$(gdbus call --session --timeout "${GDBUS_TIMEOUT:-25}" --dest "$DEST" --object-path "$PATH_" \
        --method "$IFACE.$method" "$@")
    # gdbus は ('...',) 形式で返すので中身だけ取り出す
    out=${out#\(\'}
    out=${out%\',\)}
    printf '%b\n' "$out"
}

# ランチャー: 色を検証 → コマンドを起動 → 拡張にその PID の窓への着色を依頼して待つ
run_launcher() {
    local color=${1:?色を指定してください (例: wincolor run red firefox)}; shift
    [ $# -ge 1 ] || { echo "error: 起動するコマンドを指定してください (例: wincolor run red firefox)" >&2; exit 2; }
    # 色の事前検証 (プリセット名 / ラベル / #RRGGBB)。起動してから失敗しないように先に見る
    if ! [[ $color =~ ^#[0-9A-Fa-f]{6}$ ]] && \
       ! call Palette | awk -F'\t' -v c="$color" 'tolower($1)==tolower(c) || $2==c {found=1} END {exit !found}'; then
        echo "error: 不明な色です: $color (wincolor colors で一覧)" >&2; exit 2
    fi
    local timeout_s=${WINCOLOR_RUN_TIMEOUT:-10}
    "$@" &
    local pid=$!
    disown "$pid" 2>/dev/null || true
    GDBUS_TIMEOUT=$((timeout_s + 5)) call TagPid "$pid" "$color" "$((timeout_s * 1000))"
}

case "${1:-}" in
    run)       shift; run_launcher "$@" ;;
    list)      call List ;;
    colors)    call Palette ;;
    rules)     call Rules ;;
    reload)    call Reload ;;
    clear-all) call ClearAll ;;
    --version) echo "wincolor (linux) v$WINCOLOR_VERSION" ;;
    ""|-h|--help)
        # 先頭のコメントブロック (2 行目〜最初の非コメント行) だけを出す。本文中のコメントは含めない
        sed -n '2,/^[^#]/{/^#/p}' "$0" | sed 's/^# \{0,1\}//' ;;
    *)
        target=$1
        color=${2:?色を指定してください (例: wincolor $target red / off)}
        if [ "$color" = off ]; then
            call Clear "$target"
        else
            call Set "$target" "$color"
        fi ;;
esac
